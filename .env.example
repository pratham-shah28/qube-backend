# SQLite file path. Use a path on a persistent volume in production.
QUBE_DB_URL=sqlite:///./qube.db
# openssl rand -hex 32
QUBE_JWT_SECRET=change-me
# 16-byte master key for tag key derivation, hex. openssl rand -hex 16
# Never commit the real value.
QUBE_MASTER_KEY=00000000000000000000000000000000
